#! /bin/sh

version=34.2
revision=1
tarball_url="https://cdn.kernel.org/pub/linux/utils/kernel/kmod/kmod-${version}.tar.xz"
tarball_blake2b="73e7664ef882f5d17985230797d619716b52adfbd39761579a375cdda1f516a0e120b8e3a753983d44b4cff08d3109737aca0b19283549c53a6cc2772f7ae812"
hostdeps="gcc pkg-config"
deps="core-libs zlib xz zstd"

configure() {
    meson_configure \
        -Dmoduledir=${prefix}/lib/modules \
        -Dopenssl=disabled \
        -Dmanpages=false \
        -Ddocs=false \
        -Dbuild-tests=false
}

build() {
    meson compile --verbose -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" meson install --no-rebuild

    post_package_strip
}
