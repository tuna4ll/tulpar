#! /bin/sh

version=0.10.1
revision=1
tarball_url="https://github.com/wmww/gtk-layer-shell/archive/refs/tags/v${version}.tar.gz"
tarball_blake2b="a1cfcf5fb0bbcebb1c3970ca42291b079d628a9467a880b59bf3c4815403879bb25b7311185433cc8448ca85e9d3c3fc5aff6b2243646a526c8f3788aea28285"
imagedeps="libwayland-bin libwayland-dev pkgconf"
hostdeps="gcc pkg-config"
deps="core-libs gtk3 wayland wayland-protocols"

configure() {
    meson_configure \
        -Dexamples=false \
        -Ddocs=false \
        -Dtests=false \
        -Dintrospection=false \
        -Dvapi=false
}

build() {
    meson compile -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" meson install --no-rebuild

    post_package_strip
}
