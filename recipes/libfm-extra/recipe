#! /bin/sh

# libfm's tree, built only for the small library menu-cache needs.
version=1.3.2
revision=1
tarball_url="https://downloads.sourceforge.net/pcmanfm/libfm-${version}.tar.xz"
tarball_blake2b="d596d64c82c5e49c61bc4c08ee3c2b02aae2d4d000d6154af4470a8f5a392ad7d80a7435d7477463c8c7f1dfb9ece8e74884a55cc557f17b7fe82becb55f7afb"
imagedeps="intltool"
hostdeps="gcc pkg-config"
deps="core-libs glib2"

prepare() {
    autotools_recursive_regen
}

configure() {
    autotools_configure \
        --with-extra-only \
        --with-gtk=no \
        --disable-gtk-doc
}

build() {
    make -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" make install

    post_package_strip
}
