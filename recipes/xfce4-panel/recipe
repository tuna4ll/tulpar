#! /bin/sh

version=4.20.8
revision=1
tarball_url="https://archive.xfce.org/src/xfce/xfce4-panel/4.20/xfce4-panel-${version}.tar.bz2"
tarball_blake2b="8335b494915dfb532aa6ce8012684a843a26edd0a791645798abb87e810aa81833d404b44090f4e3445068e6c90835671ee062bca7d297cee317fc9d0171ff86"
imagedeps="libglib2.0-dev-bin libglib2.0-bin xfce4-dev-tools"
hostdeps="gcc pkg-config"
deps="core-libs glib2 gtk3 cairo exo garcon libwnck libxfce4ui libxfce4util libxfce4windowing xfconf libx11 libxext"

configure() {
    meson_configure \
        -Dintrospection=false \
        -Dvala=disabled \
        -Dwayland=disabled \
        -Dx11=enabled \
        -Dgtk-layer-shell=disabled \
        -Ddbusmenu=disabled
}

build() {
    meson compile -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" meson install --no-rebuild

    post_package_strip
}
