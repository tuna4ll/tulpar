#! /bin/sh

version=1.7.2
revision=1
tarball_url="https://www.kernel.org/pub/software/utils/dtc/dtc-${version}.tar.xz"
tarball_blake2b="d345027614a4caff9912b39286e35c1a889bbfd88630bac1c9c48223a6171bd6a8661342c89355e63301b395d1c238be82d21d870b0dd5fc05ae5dd552e730a6"
imagedeps="bison flex"
hostdeps="gcc pkg-config"
deps="core-libs"

configure() {
    # dtc builds with -Werror, and glibc's const-preserving memchr now warns where libfdt
    # assigns its result to a plain pointer.
    meson_configure \
        -Dwerror=false \
        -Dtools=true \
        -Dyaml=disabled \
        -Dvalgrind=disabled \
        -Dpython=disabled \
        -Dtests=false
}

build() {
    meson compile --verbose -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" meson install --no-rebuild

    post_package_strip
}
