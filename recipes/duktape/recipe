#! /bin/sh

version=2.7.0
revision=1
tarball_url="https://github.com/svaarala/duktape/releases/download/v${version}/duktape-${version}.tar.xz"
tarball_blake2b="da5eea88758201177f32c5611a3757433ef1b0173d6430eff1f067abd7535f3e4b9c3717290fbd8475827a53f7a2a74818287a65e563f14e91761f5cd0fe30d5"
hostdeps="gcc pkg-config"
deps="core-libs"

build() {
    cp -rp "${source_dir}"/. ./
    make -f Makefile.sharedlibrary CC=${OS_TRIPLET}-gcc INSTALL_PREFIX=${prefix} \
        CFLAGS="${TARGET_CFLAGS} -fPIC" LDFLAGS="${TARGET_LDFLAGS}"
}

package() {
    make -f Makefile.sharedlibrary INSTALL_PREFIX=${prefix} DESTDIR="${dest_dir}" install

    post_package_strip
}
