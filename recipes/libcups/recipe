#! /bin/sh

# Only the CUPS client library, which Electron apps such as Discord link.
version=2.4.19
revision=1
tarball_url="https://github.com/OpenPrinting/cups/releases/download/v${version}/cups-${version}-source.tar.gz"
tarball_blake2b="6c6a4c5b15e1ed4ae10abb21c9f4c6a4820df3f2289b478510579a455d3ceb82c6bac850765f05d6671588fdbfed1942e6e84e9a12c4547daa89a740bf3c3419"
hostdeps="gcc pkg-config"
deps="core-libs gnutls zlib"

configure() {
    # CUPS builds next to its sources.
    cp -rp "${source_dir}"/. ./
    configure_script_path=./configure \
    autotools_configure \
        --with-tls=gnutls \
        --disable-dbus \
        --disable-pam \
        --with-dnssd=no \
        --without-systemd \
        --disable-static \
        ac_cv_path_AR="$(command -v ${OS_TRIPLET}-ar)"
}

build() {
    make -C cups -j${parallelism} libs
}

package() {
    make -C cups DESTDIR="${dest_dir}" install-libs install-headers
    install -Dm644 cups.pc "${dest_dir}${prefix}/lib/pkgconfig/cups.pc"

    post_package_strip
}
