#! /bin/sh

version=6.10.2
revision=1
tarball_url="https://download.qt.io/archive/qt/6.10/${version}/submodules/qtsvg-everywhere-src-${version}.tar.xz"
tarball_blake2b="9936efc2ead690b7810c96c8517d9789bbf4912cad07d1d403e5816ec18b3441d14394672dec82eade551dffa69d0436714be812bcc888d8a1b552587e08c6c2"
imagedeps="qt6-base-dev qt6-base-dev-tools qt6-tools-dev qt6-tools-dev-tools ninja-build"
hostdeps="gcc pkg-config"
deps="core-libs qt6-base zlib"

configure() {
    qt_cmake_configure \
        -GNinja \
        -DINSTALL_BINDIR=lib/qt6/bin \
        -DINSTALL_PUBLICBINDIR=bin \
        -DINSTALL_LIBEXECDIR=lib/qt6/libexec \
        -DINSTALL_ARCHDATADIR=lib/qt6 \
        -DINSTALL_DATADIR=share/qt6 \
        -DINSTALL_INCLUDEDIR=include/qt6 \
        -DINSTALL_MKSPECSDIR=lib/qt6/mkspecs \
        -DINSTALL_PLUGINSDIR=lib/qt6/plugins \
        -DINSTALL_QMLDIR=lib/qt6/qml \
        -DINSTALL_TRANSLATIONSDIR=share/qt6/translations
}

build() {
    cmake --build . -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" cmake --install .

    post_package_strip
}
