#! /bin/sh

version=18.1
revision=2
tarball_url="https://ftp.gnu.org/gnu/gdb/gdb-${version}.tar.xz"
tarball_blake2b="9cf68cd96ecd1b2f51235f80f30d4024eadea7e11fe8af1cde0103176c622b770d79fde2205739fad8fe314ffecddd450626976e1897b04899027d0d88f30e1d"
imagedeps="build-essential texinfo"
hostdeps="gcc pkg-config"
deps="core-libs gmp mpfr libexpat ncurses readline xz zstd"

configure() {
    autotools_configure \
        --with-system-readline \
        --with-expat \
        --with-python=no \
        --disable-sim \
        --disable-nls \
        --with-gmp=${sysroot}${prefix} \
        --with-mpfr=${sysroot}${prefix} \
        --disable-shared
}

build() {
    make -j${parallelism} all-gdb all-gdbserver
}

package() {
    # Only gdb itself, with the tree's bfd and opcodes linked in statically.
    DESTDIR="${dest_dir}" make install-gdb install-gdbserver

    post_package_strip
}
