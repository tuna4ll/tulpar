#! /bin/sh

version=2.5.4
revision=1
tarball_url="https://ftpmirror.gnu.org/libtool/libtool-${version}.tar.xz"
tarball_blake2b="47de3c49a690d44d7ddd5e3b5e4090c91dc5fbb9c40fc4a3963e150fb7329326ee3e21b8c149974726171c4b0380028e0efc7a369c4f04357eea46f69852e1cc"
hostdeps="gcc pkg-config"
deps="core-libs"

configure() {
    autotools_configure \
        --enable-ltdl-install
}

build() {
    make -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" make install
    # Only the library: the libtool script and macros belong to the build machine.
    rm -rf "${dest_dir}${prefix}/bin" "${dest_dir}${prefix}/share"

    post_package_strip
}
