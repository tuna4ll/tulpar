#! /bin/sh

version=1.28.0
revision=1
tarball_url="https://github.com/mate-desktop/libmatemixer/releases/download/v${version}/libmatemixer-${version}.tar.xz"
tarball_blake2b="8f747bfe304082caea08b7443ba3b3170b8dcaf049dd8c3eabe2eb3124007e9c80b17d400ea8bb522031309f3428674e4a50ca7ad15939ad9a47fe82a09d3a41"
imagedeps="libglib2.0-dev-bin libglib2.0-bin gettext itstool"
hostdeps="gcc pkg-config"
deps="core-libs glib2 libpulse alsa-lib"

configure() {
    autotools_configure \
        --enable-pulseaudio \
        --enable-alsa \
        --disable-oss \
        --disable-udev
}

build() {
    # Some Makefiles ask a bare pkg-config, which a cross build lacks, for it.
    make -j${parallelism} GLIB_GENMARSHAL=/usr/bin/glib-genmarshal
}

package() {
    DESTDIR="${dest_dir}" make install
    rm -f "${dest_dir}${prefix}/share/glib-2.0/schemas/gschemas.compiled"
    rm -f "${dest_dir}${prefix}/share/icons/"*/icon-theme.cache

    post_package_strip
}
