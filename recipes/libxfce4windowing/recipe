#! /bin/sh

version=4.20.7
revision=1
tarball_url="https://archive.xfce.org/src/xfce/libxfce4windowing/4.20/libxfce4windowing-${version}.tar.bz2"
tarball_blake2b="66784c051892bd54e3a9fd909989a4d987fb151ce5bf9be460ee73518785ffa102110c2b29639f1400402364615c1fb840822ed1bd939edab5167bfff6806974"
imagedeps="libglib2.0-dev-bin libglib2.0-bin xfce4-dev-tools"
hostdeps="gcc pkg-config"
deps="core-libs glib2 gtk3 libdisplay-info libwnck libx11 libxrandr"

configure() {
    meson_configure \
        -Dintrospection=false \
        -Dvala=disabled \
        -Dwayland=disabled \
        -Dx11=enabled \
        -Dtests=false
}

build() {
    meson compile -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" meson install --no-rebuild

    post_package_strip
}
