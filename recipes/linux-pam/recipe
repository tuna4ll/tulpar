#! /bin/sh

version=1.7.3
revision=1
tarball_url="https://github.com/linux-pam/linux-pam/releases/download/v${version}/Linux-PAM-${version}.tar.xz"
tarball_blake2b="2476e5b08f8e4c3e013f8ee22d858da79e9074160d396b504400c1f7ee490df9b432b226d18ae58e6f5c77a0a31709d363b76c800cd86953237f7e534a317358"
hostdeps="gcc pkg-config"
deps="core-libs libxcrypt"

configure() {
    # Tulpar has no logind, audit, SELinux or NIS; pam_unix reads /etc/shadow.
    meson_configure \
        -Ddocs=disabled \
        -Daudit=disabled \
        -Deconf=disabled \
        -Dlogind=disabled \
        -Delogind=disabled \
        -Dselinux=disabled \
        -Dnis=disabled \
        -Dopenssl=disabled \
        -Dpwaccess=disabled \
        -Dpam_userdb=disabled \
        -Dpam_lastlog=disabled \
        -Dexamples=false \
        -Dxtests=false \
        -Dvendordir=
}

build() {
    meson compile -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" meson install --no-rebuild

    # Services without a file of their own are refused.
    install -Dm644 /dev/stdin "${dest_dir}"/etc/pam.d/other <<'PAM'
#%PAM-1.0
auth     required pam_deny.so
account  required pam_deny.so
password required pam_deny.so
session  required pam_deny.so
PAM

    # Lets programs that are not root check their user's password, as on Arch.
    chmod 4755 "${dest_dir}${prefix}"/bin/unix_chkpwd

    post_package_strip
}
