#! /bin/sh

version=1.28.0
revision=1
tarball_url="https://github.com/mate-desktop/libmatekbd/releases/download/v${version}/libmatekbd-${version}.tar.xz"
tarball_blake2b="297559c75fec4d283a7c06a0bfa3d2c7a90f84f42b70970c2b5e4a533bba1ce411bae258871088a77c55eaa29045802dcba114c8966a24afb7cd1c46fdca1f66"
imagedeps="libglib2.0-dev-bin libglib2.0-bin gettext itstool"
hostdeps="gcc pkg-config"
deps="core-libs glib2 gtk3 libxklavier libx11"

configure() {
    autotools_configure \
        --disable-tests \
        --disable-introspection \
        --disable-schemas-compile
}

build() {
    # Some Makefiles ask a bare pkg-config, which a cross build lacks, for it.
    make -j${parallelism} GLIB_GENMARSHAL=/usr/bin/glib-genmarshal
}

package() {
    DESTDIR="${dest_dir}" make install
    rm -f "${dest_dir}${prefix}/share/glib-2.0/schemas/gschemas.compiled"
    rm -f "${dest_dir}${prefix}/share/icons/"*/icon-theme.cache

    post_package_strip

    generate_glib_schemas_hook
}
