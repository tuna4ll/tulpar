#! /bin/sh

version=3.24.11
revision=1
tarball_url="https://download.gnome.org/sources/gtkmm/3.24/gtkmm-${version}.tar.xz"
tarball_blake2b="17cc7a77f2a7799fe67e1d439ee60d053e985566d3b0f630231c2d7a8883fabbb54254970d1cd29b0ddaad66355e5336df6f769724df7b87814d2e9641f782e9"
imagedeps="libglib2.0-dev-bin libgdk-pixbuf2.0-bin"
hostdeps="gcc pkg-config"
deps="core-libs libstdc++ gtk3 gdk-pixbuf glibmm cairomm pangomm atkmm"

configure() {
    meson_configure \
        -Dmaintainer-mode=false \
        -Dbuild-documentation=false \
        -Dbuild-demos=false \
        -Dbuild-tests=false
}

build() {
    meson compile -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" meson install --no-rebuild

    post_package_strip
}
