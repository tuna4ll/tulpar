#! /bin/sh

version=0.9.1
revision=1
tarball_url="https://git.sr.ht/~kennylevinsen/seatd/archive/${version}.tar.gz"
tarball_blake2b="f935165c00bf0e35d73809d408ae1e0500a8d5be286fba2d14ee30704d0e8555f67f964bf06fb71245eed090b1d1a00abdb26406e0a617e9a592546401f653d2"
hostdeps="gcc pkg-config"
deps="core-libs"

configure() {
    meson_configure \
        -Dlibseat-logind=disabled \
        -Dlibseat-seatd=enabled \
        -Dlibseat-builtin=enabled \
        -Dserver=enabled \
        -Dexamples=disabled \
        -Dman-pages=disabled \
        -Dwerror=false
}

build() {
    meson compile -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" meson install --no-rebuild

    # Members of video, which the tulpar user is, may open a seat.
    install -Dm755 /dev/stdin "${dest_dir}"/etc/sv/seatd/run <<'RUN'
#!/bin/sh
exec seatd -g video
RUN
    mkdir -p "${dest_dir}"/etc/runit/runsvdir/default
    ln -s /etc/sv/seatd "${dest_dir}"/etc/runit/runsvdir/default/seatd

    post_package_strip
}
