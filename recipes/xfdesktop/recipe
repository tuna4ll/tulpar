#! /bin/sh

version=4.20.2
revision=1
tarball_url="https://archive.xfce.org/src/xfce/xfdesktop/4.20/xfdesktop-${version}.tar.bz2"
tarball_blake2b="32ee6d4d9fd33620842a2bbfa7fe1bba077d145b1d241ff36a93513937eedd524cb468fe3a2d0e4278b1244033446690aaf747d2e7e5cd76536ea5d5d74e08ba"
imagedeps="libglib2.0-dev-bin libglib2.0-bin xfce4-dev-tools"
hostdeps="gcc pkg-config"
deps="core-libs glib2 gtk3 exo garcon libnotify libxfce4ui libxfce4util libxfce4windowing libyaml xfconf thunar libx11"

configure() {
    meson_configure \
        -Dwayland=disabled \
        -Dx11=enabled \
        -Dtests=false \
        -Ddefault-backdrop-filename=backgrounds/xfce/xfce-blue.jpg
}

build() {
    meson compile -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" meson install --no-rebuild

    post_package_strip
}
