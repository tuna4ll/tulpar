#! /bin/sh

version=1.28.2
revision=1
tarball_url="https://github.com/mate-desktop/mate-session-manager/releases/download/v${version}/mate-session-manager-${version}.tar.xz"
tarball_blake2b="26242756b9b4ad2a7b45c659996640d55513aa0f50cae144dd35ee1d1e48b6334ebf3faa439ea4fc40e357eae52f082030b428f6ba78f74e4fb5b6256901fdc4"
imagedeps="libglib2.0-dev-bin libglib2.0-bin gettext itstool"
hostdeps="gcc pkg-config"
deps="core-libs glib2 gtk3 dbus-glib libsm libice libxext libxau libxcomposite libxtst libxrender mesa libepoxy mate-desktop xtrans"

configure() {
    autotools_configure \
        --disable-schemas-compile \
        --with-default-wm=marco \
        --without-systemd \
        --without-elogind \
        --disable-docbook-docs
}

build() {
    # Some Makefiles ask a bare pkg-config, which a cross build lacks, for it.
    make -j${parallelism} GLIB_GENMARSHAL=/usr/bin/glib-genmarshal
}

package() {
    DESTDIR="${dest_dir}" make install
    rm -f "${dest_dir}${prefix}/share/glib-2.0/schemas/gschemas.compiled"
    rm -f "${dest_dir}${prefix}/share/icons/"*/icon-theme.cache

    post_package_strip

    generate_glib_schemas_hook
}
