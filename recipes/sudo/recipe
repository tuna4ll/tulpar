#! /bin/sh

version=1.9.17p2
revision=1
tarball_url="https://www.sudo.ws/dist/sudo-${version}.tar.gz"
tarball_blake2b="dd42ff4fd571ba8489cc59d71a09c7e0483d21daf9faf7e697beedc04d9f170b01e60446af179c949a3da115b616fbec07aff8fbf8b7d502161c24d1b35b7a69"
imagedeps="build-essential"
hostdeps="gcc pkg-config"
deps="core-libs zlib"
conf_files="/etc/sudoers"

configure() {
    autotools_configure \
        --libexecdir=${prefix}/lib \
        --with-secure-path \
        --with-env-editor \
        --without-pam \
        --disable-openssl \
        --with-passprompt="[sudo] password for %p: "
}

build() {
    make -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" make install

    # Tulpar's users have no passwords, so members of wheel are not asked for one.
    sed -i 's/^# %wheel ALL=(ALL:ALL) NOPASSWD: ALL/%wheel ALL=(ALL:ALL) NOPASSWD: ALL/' "${dest_dir}"/etc/sudoers
    grep -q '^%wheel' "${dest_dir}"/etc/sudoers
    rm -rf "${dest_dir}"/run

    post_package_strip
}
