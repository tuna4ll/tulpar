#! /bin/sh

version=1.28.0
revision=1
tarball_url="https://github.com/mate-desktop/mate-icon-theme/releases/download/v${version}/mate-icon-theme-${version}.tar.xz"
tarball_blake2b="18b7f43c5a1a0c8f9a45feb0d4941d659d67d98918227615d12acd176cc3cf96a8eb48c9d9bfebe4710417b3fffabc89d433d51c44b42df16bf62332a743b6ae"
imagedeps="libglib2.0-dev-bin libglib2.0-bin gettext itstool"
hostdeps="gcc pkg-config"
deps="hicolor-icon-theme"

configure() {
    autotools_configure \
        --disable-icon-mapping
}

build() {
    make -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" make install
    rm -f "${dest_dir}${prefix}/share/glib-2.0/schemas/gschemas.compiled"
    rm -f "${dest_dir}${prefix}/share/icons/"*/icon-theme.cache

    post_package_strip
}
