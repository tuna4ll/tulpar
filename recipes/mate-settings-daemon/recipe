#! /bin/sh

version=1.28.0
revision=1
tarball_url="https://github.com/mate-desktop/mate-settings-daemon/releases/download/v${version}/mate-settings-daemon-${version}.tar.xz"
tarball_blake2b="fab6b5ffb28039474976b1ad3f82e8096c568186df8a7f796e95ce8b7dbed72e35feee30b5f6cff14de8df4d1048d697543ec9f29e59d37171e708b8a12556c9"
imagedeps="libglib2.0-dev-bin libglib2.0-bin gettext itstool"
hostdeps="gcc pkg-config"
deps="core-libs glib2 gtk3 dconf dbus-glib mate-desktop libmatekbd libxklavier libmatemixer libcanberra libnotify libpulse polkit fontconfig libxi libx11"

configure() {
    autotools_configure \
        --disable-schemas-compile \
        --disable-smartcard-support \
        --enable-pulse \
        --enable-polkit \
        --disable-rfkill
}

build() {
    # Some Makefiles ask a bare pkg-config, which a cross build lacks, for it.
    make -j${parallelism} GLIB_GENMARSHAL=/usr/bin/glib-genmarshal \
        GETTEXTDATADIRS="${sysroot}${prefix}/share/gettext"
}

package() {
    DESTDIR="${dest_dir}" make install
    rm -f "${dest_dir}${prefix}/share/glib-2.0/schemas/gschemas.compiled"
    rm -f "${dest_dir}${prefix}/share/icons/"*/icon-theme.cache

    post_package_strip

    generate_glib_schemas_hook
}
