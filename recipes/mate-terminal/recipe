#! /bin/sh

version=1.28.3
revision=1
tarball_url="https://github.com/mate-desktop/mate-terminal/releases/download/v${version}/mate-terminal-${version}.tar.xz"
tarball_blake2b="8d2b07f950a2cfcaaf84f98896286deac81c20f970e7e082f18f66ed325d9e778fa7888b649b458ceec3c4e53ab304d5988f9fd58697bbdc2b64a61d5ced470b"
imagedeps="libglib2.0-dev-bin libglib2.0-bin gettext itstool"
hostdeps="gcc pkg-config"
deps="core-libs glib2 gtk3 vte dconf libsm libice"

configure() {
    autotools_configure \
        --disable-schemas-compile
}

build() {
    make -j${parallelism} GLIB_GENMARSHAL=/usr/bin/glib-genmarshal
}

package() {
    DESTDIR="${dest_dir}" make install
    rm -f "${dest_dir}${prefix}/share/glib-2.0/schemas/gschemas.compiled"
    rm -f "${dest_dir}${prefix}/share/icons/"*/icon-theme.cache

    post_package_strip

    generate_glib_schemas_hook
}
