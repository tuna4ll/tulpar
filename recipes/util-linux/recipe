#! /bin/sh

version=2.42
revision=1
tarball_url="https://cdn.kernel.org/pub/linux/utils/util-linux/v${version}/util-linux-${version}.tar.xz"
tarball_blake2b="531b79bbec272cf1007c55ff4042b5e1b14bcc0dc098e54e4b76ea2e70c785fc763f96686ad8cea5ea9c0f7190794f4d828b7742e3aa18a0c3ef506d34e9d465"
hostdeps="gcc pkg-config"
deps="core-libs ncurses readline zlib libxcrypt"

prepare() {
    autotools_recursive_regen
}

configure() {
    # login, su, nologin and friends come from shadow.
    autotools_configure \
        --runstatedir=/run \
        --disable-chfn-chsh \
        --disable-login \
        --disable-nologin \
        --disable-su \
        --disable-newgrp \
        --disable-vipw \
        --disable-liblastlog2 \
        --disable-pylibmount \
        --disable-makeinstall-chown \
        --disable-makeinstall-setuid \
        --without-python \
        --without-systemd \
        --without-udev \
        --without-btrfs
}

build() {
    make -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" make install

    # util-linux puts some tools in sbin regardless; /usr/sbin is a symlink here.
    if [ -d "${dest_dir}${prefix}"/sbin ]; then
        mv "${dest_dir}${prefix}"/sbin/* "${dest_dir}${prefix}"/bin/
        rmdir "${dest_dir}${prefix}"/sbin
    fi

    post_package_strip
}
