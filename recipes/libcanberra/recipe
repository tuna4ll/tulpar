#! /bin/sh

version=0.30
revision=1
tarball_url="http://0pointer.de/lennart/projects/libcanberra/libcanberra-${version}.tar.xz"
tarball_blake2b="c90c6863738b103c256eeb0907060a0f74b73ef50ac0728d2114aa558a7a1ad7cbae4184860573d3fac0032eba77327a4de94c459b99a81c3dc19da0e98adfda"
hostdeps="gcc pkg-config"
deps="core-libs libvorbis libltdl alsa-lib libpulse gtk3"

prepare() {
    autotools_recursive_regen
}

configure() {
    autotools_configure \
        --disable-oss \
        --enable-alsa \
        --enable-pulse \
        --disable-gstreamer \
        --disable-tdb \
        --disable-lynx \
        --disable-gtk \
        --enable-gtk3 \
        --disable-udev \
        --with-builtin=dso
}

build() {
    make -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" make install

    post_package_strip
}
