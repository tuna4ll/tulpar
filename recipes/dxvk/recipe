#! /bin/sh

version=3.1.1
revision=1
git_url="https://github.com/doitsujin/dxvk.git"
commit=b1a1c99ab52b687cf950d62c88bc2fa316b41663
source_imagedeps="git ca-certificates"
# DXVK is Windows code: Direct3D 8 to 11 on Vulkan, as DLLs Wine loads instead of its own.
imagedeps="meson ninja-build glslang-tools gcc-mingw-w64-x86-64-posix g++-mingw-w64-x86-64-posix"
deps="wine vulkan-loader"

early_prepare() {
    # The Vulkan, SPIR-V and DirectX headers are submodules.
    git submodule update --init --recursive --depth 1
}

configure() {
    # Built for 64-bit Windows programs only, as Wine is.
    [ "${JINX_ARCH}" = x86_64 ] || { echo "DXVK is only built for x86_64" >&2; return 1; }
    meson setup "${source_dir}" \
        --cross-file "${source_dir}"/build-win64.txt \
        --prefix=${prefix} \
        --bindir=lib/dxvk/x64 \
        --libdir=lib/dxvk/x64 \
        --buildtype=release \
        --strip \
        -Dbuild_id=false
}

build() {
    ninja -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" ninja install
    rm -f "${dest_dir}${prefix}"/lib/dxvk/x64/*.a

    # Puts the DLLs into a Wine prefix and tells Wine to prefer them to its own.
    install -Dm755 /dev/stdin "${dest_dir}${prefix}"/bin/setup-dxvk <<'EOF'
#! /bin/sh
# setup-dxvk install|uninstall: DXVK in $WINEPREFIX (default ~/.wine).
set -e
prefix=${WINEPREFIX:-$HOME/.wine}
dlls="d3d8 d3d9 d3d10core d3d11 dxgi"
[ -d "$prefix/drive_c/windows/system32" ] || wineboot -i
case "${1:-install}" in
install)
    for dll in $dlls; do
        cp /usr/lib/dxvk/x64/$dll.dll "$prefix/drive_c/windows/system32/$dll.dll"
        wine reg add 'HKCU\Software\Wine\DllOverrides' /v $dll /d native /f > /dev/null
    done
    echo "DXVK is installed in $prefix" ;;
uninstall)
    for dll in $dlls; do
        wine reg delete 'HKCU\Software\Wine\DllOverrides' /v $dll /f > /dev/null 2>&1 || true
    done
    wineboot -u
    echo "DXVK is removed from $prefix" ;;
*)
    echo "usage: setup-dxvk install|uninstall" >&2; exit 1 ;;
esac
EOF
}
