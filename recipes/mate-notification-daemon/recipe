#! /bin/sh

version=1.28.5
revision=1
tarball_url="https://github.com/mate-desktop/mate-notification-daemon/releases/download/v${version}/mate-notification-daemon-${version}.tar.xz"
tarball_blake2b="fa5e3577f8c05bc0ab8ed5f6dcc6a5726e482e1d9d5a4e27a146acd3efa798330fc32f1d9668bdc945a519d5a8045952c679eb872c73f8d701541a49be798788"
imagedeps="libglib2.0-dev-bin libglib2.0-bin gettext itstool"
hostdeps="gcc pkg-config"
deps="core-libs glib2 gtk3 libnotify libcanberra libwnck mate-desktop mate-panel"

configure() {
    autotools_configure \
        --disable-schemas-compile \
        --disable-wayland \
        --disable-icon-update
}

build() {
    # Some Makefiles ask a bare pkg-config, which a cross build lacks, for it.
    make -j${parallelism} GLIB_GENMARSHAL=/usr/bin/glib-genmarshal
}

package() {
    DESTDIR="${dest_dir}" make install
    rm -f "${dest_dir}${prefix}/share/glib-2.0/schemas/gschemas.compiled"
    rm -f "${dest_dir}${prefix}/share/icons/"*/icon-theme.cache

    post_package_strip

    generate_glib_schemas_hook
}
