#! /bin/sh

version=1.28.2
revision=1
tarball_url="https://github.com/mate-desktop/marco/releases/download/v${version}/marco-${version}.tar.xz"
tarball_blake2b="f686789f9a05803a55f87feae8a3f888ae410930fd8fe3a144ddba098ffc50670b990d94da0051efe9670f7c8deb9b4b2ad807a023f78fde3ce5406d6166e6c3"
imagedeps="libglib2.0-dev-bin libglib2.0-bin gettext itstool libgdk-pixbuf2.0-bin libgdk-pixbuf-2.0-dev build-essential zenity"
hostdeps="gcc pkg-config"
deps="core-libs glib2 gtk3 pango mate-desktop libcanberra libxres libx11 libxcomposite libxdamage libxfixes libxrender libxrandr libxinerama libxcursor libsm libice startup-notification libgtop"

configure() {
    meson_configure \
        -Dstartup-notification=true \
        -Dcompositor=true \
        -Dsm=true \
        -Dxinerama=true
}

build() {
    meson compile -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" meson install --no-rebuild
    rm -f "${dest_dir}${prefix}/share/glib-2.0/schemas/gschemas.compiled"
    rm -f "${dest_dir}${prefix}/share/icons/"*/icon-theme.cache

    post_package_strip

    generate_glib_schemas_hook
}
