#! /bin/sh

version=4.20.0
revision=1
tarball_url="https://archive.xfce.org/src/xfce/xfwm4/4.20/xfwm4-${version}.tar.bz2"
tarball_blake2b="999b50c046582241bcc565e3af313a61ee3bee7b00b359d826ed32ac2c36d25cc299810325ac81617d59a8292d2791947a51d4c1ec4949d794f999bd24d1417e"
imagedeps="libglib2.0-dev-bin libglib2.0-bin"
hostdeps="gcc pkg-config"
deps="core-libs glib2 gtk3 libxfce4util libxfce4ui xfconf libwnck libxinerama libxrandr libxrender libxdamage libxfixes libxres libx11"

prepare() {
    autotools_recursive_regen
}

configure() {
    # The resource compiler pkg-config names is the target's own, which cannot run here.
        GLIB_COMPILE_RESOURCES=/usr/bin/glib-compile-resources \
    autotools_configure \
        --disable-startup-notification \
        --disable-xsync
}

build() {
    make -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" make install

    post_package_strip
}
