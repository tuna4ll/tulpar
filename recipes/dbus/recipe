#! /bin/sh

version=1.16.2
revision=10
tarball_url="https://dbus.freedesktop.org/releases/dbus/dbus-${version}.tar.xz"
tarball_blake2b="ddca8abdd5df70b24d51293a262cda3f9e69681b31ae8bb560a6286ca6f2dc0c420dc5322a61bb142a77b2b5f86bdafcc6bf84b0d78af9610af7a78763b8b8fb"
hostdeps="gcc pkg-config"
deps="core-libs libexpat libx11"

configure() {
    meson_configure \
        -Druntime_dir=/run \
        -Dsystemd_system_unitdir=no \
        -Dsystemd_user_unitdir=no \
        -Dsystem_pid_file=/run/dbus/pid \
        -Dsystem_socket=/run/dbus/system_bus_socket \
        -Dselinux=disabled \
        -Dapparmor=disabled \
        -Dlibaudit=disabled \
        -Dkqueue=disabled \
        -Dlaunchd=disabled \
        -Dsystemd=disabled \
        -Dducktype_docs=disabled \
        -Dqt_help=disabled \
        -Depoll=disabled \
        -Dinotify=disabled \
        -Dx11_autolaunch=enabled \
        -Dmodular_tests=disabled
}

build() {
    meson compile --verbose -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" meson install --no-rebuild

    touch "${dest_dir}${prefix}"/share/dbus-1/session.d/.keep


    # The system bus, which LightDM and most desktop programs look for.
    install -Dm755 /dev/stdin "${dest_dir}"/etc/sv/dbus/run <<'RUN'
#!/bin/sh
install -d -o messagebus -g messagebus -m 0755 /run/dbus
rm -f /run/dbus/pid
dbus-uuidgen --ensure
exec dbus-daemon --system --nofork --nopidfile
RUN
    mkdir -p "${dest_dir}"/etc/runit/runsvdir/default
    ln -s /etc/sv/dbus "${dest_dir}"/etc/runit/runsvdir/default/dbus

    post_package_strip

    # The system bus starts activatable services (polkitd among them) through
    # this helper, which must be setuid root and run by messagebus only; the
    # package cannot carry the group, so it is set here.
    install_hook_add 'mkdir -p /var/lib/dbus' \
                     'dbus-uuidgen --ensure >/var/lib/dbus/machine-id' \
                     'chgrp messagebus usr/libexec/dbus-daemon-launch-helper' \
                     'chmod 4750 usr/libexec/dbus-daemon-launch-helper'
}
