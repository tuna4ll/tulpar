#! /bin/sh

version=1.2.2
revision=1
tarball_url="https://github.com/libsndfile/libsndfile/releases/download/${version}/libsndfile-${version}.tar.xz"
tarball_blake2b="bc8e49983d9ad9dfd98984e2ffef501c6f576480e556e9f9ef91c7d597524cc1bb8baed15dfef8e239f72c42136c524117029eb8271f3a2c9d607fee490279b5"
hostdeps="gcc pkg-config"
deps="core-libs"

configure() {
    # WAV, AIFF, AU and the other built-in formats; Ogg, FLAC and MP3 would
    # need libraries Tulpar does not have yet.
    cmake_configure \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_TESTING=OFF \
        -DBUILD_EXAMPLES=OFF \
        -DBUILD_PROGRAMS=ON \
        -DENABLE_EXTERNAL_LIBS=OFF \
        -DENABLE_MPEG=OFF \
        -DINSTALL_MANPAGES=ON
}

build() {
    cmake --build . -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" cmake --install .

    post_package_strip
}
