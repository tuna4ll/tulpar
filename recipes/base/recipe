#! /bin/sh

skip_pkg_check=yes
version=0.0
revision=3

# Kernel, C library, init and package manager.
deps="core-libs base-files tunix runit xbps"

# GNU userland.
deps+=" bash coreutils diffutils findutils gawk grep gzip less nano patch sed tar which"

# Everything else a Linux-compatible system is expected to have.
deps+=" util-linux shadow kmod file xz bzip2 zstd fastfetch dhcpcd ca-certificates"
