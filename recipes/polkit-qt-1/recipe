#! /bin/sh

version=0.201.1
revision=1
tarball_url="https://download.kde.org/stable/polkit-qt-1/polkit-qt-1-${version}.tar.xz"
tarball_blake2b="efb84e5111c87e50d2c9417883682a244267d1b1c1c3e1c499235ef4eee009b1aeacac0ccdfad94e75b145dbff72e83f15e5f3116f54530bfcf6389f3f83cbb8"
imagedeps="qt6-base-dev qt6-base-dev-tools qt6-tools-dev qt6-tools-dev-tools"
hostdeps="gcc pkg-config"
deps="core-libs qt6-base polkit glib2"

configure() {
    qt_cmake_configure \
        -DQT_MAJOR_VERSION=6 \
        -DBUILD_EXAMPLES=OFF
}

build() {
    cmake --build . -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" cmake --install .

    post_package_strip
}
