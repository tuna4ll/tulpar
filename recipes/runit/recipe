#! /bin/sh

version=2.2.0
revision=1
tarball_url="https://smarden.org/runit/runit-${version}.tar.gz"
tarball_blake2b="46a4b91cf180694a69ade3cabaddb35a89db516ef75e9fc69b8091a5c3570079796b8a4cf227edc74938e182833edcce7af40f01d5cb1b4032993fb094459ede"
hostdeps="gcc pkg-config"
deps="core-libs"

build() {
    cp -rp "${source_dir}"/runit-${version}/. ./

    # runit's build compiles and runs small probes; static ones run on the
    # build host whatever glibc it has, and PID 1 should not need ld.so anyway.
    # runit predates C23 and declares functions K&R-style.
    echo "${OS_TRIPLET}-gcc -std=gnu17 ${TARGET_CFLAGS}" >src/conf-cc
    echo "${OS_TRIPLET}-gcc -static ${TARGET_LDFLAGS}" >src/conf-ld

    # makelib calls bare ar and ranlib.
    sed -i -e "s/'ar cr/'${OS_TRIPLET}-ar cr/" -e "s/'ranlib /'${OS_TRIPLET}-ranlib /" src/print-ar.sh

    package/compile
}

package() {
    mkdir -p "${dest_dir}${prefix}"/bin "${dest_dir}${prefix}"/share/man/man8
    for c in $(cat package/commands); do
        install -m755 command/$c "${dest_dir}${prefix}"/bin/
    done
    install -m644 man/*.8 "${dest_dir}${prefix}"/share/man/man8/

    # Stages, services and the init symlink live in Tulpar's base-files/runit
    # tree, installed by the runit-services package.
    ln -s runit-init "${dest_dir}${prefix}"/bin/init

    post_package_strip
}
