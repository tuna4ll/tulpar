#!/bin/sh
# Stage 1: one-time setup. Tunix has already mounted /, /proc, /sys and /dev.
PATH=/usr/bin

mount -a
mkdir -p /run/runit /tmp/.ICE-unix /tmp/.X11-unix
chmod 1777 /tmp /tmp/.ICE-unix /tmp/.X11-unix
install -m000 /dev/null /run/runit/stopit
install -m000 /dev/null /run/runit/reboot

hostname "$(cat /etc/hostname)"

tulpar-first-boot

# There is no udev, so load the drivers for the devices present at boot here,
# after the first boot's hooks have run depmod.
cat /sys/bus/*/devices/*/modalias 2>/dev/null | sort -u | xargs -r modprobe -q -a -b 2>/dev/null || :
