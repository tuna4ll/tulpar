#! /bin/sh

version=2.4.131
revision=1
tarball_url="https://dri.freedesktop.org/libdrm/libdrm-${version}.tar.xz"
tarball_blake2b="e83e9cdde629fbab3a23170c964952c13dcb75e1b96773088392833f31b44f55903e01e28fc4c7d5e18c7f4fab306a5b0c8f4d4d76e5eeaac33ad3b350685a89"
hostdeps="gcc pkg-config"
deps="core-libs libpciaccess"

configure() {
    # Tunix's DRM is a generic KMS device with dumb buffers; no GPU drivers.
    meson_configure \
        -Dintel=disabled \
        -Dradeon=disabled \
        -Damdgpu=disabled \
        -Dnouveau=disabled \
        -Dvmwgfx=disabled \
        -Domap=disabled \
        -Dexynos=disabled \
        -Dfreedreno=disabled \
        -Dtegra=disabled \
        -Dvc4=disabled \
        -Detnaviv=disabled \
        -Dcairo-tests=disabled \
        -Dman-pages=disabled \
        -Dvalgrind=disabled \
        -Dtests=false
}

build() {
    meson compile --verbose -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" meson install --no-rebuild

    post_package_strip
}
